# Byte-compiled / optimized / DLL files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# OS / System files
.DS_Store
Thumbs.db
desktop.ini

# IDEs
.vscode/
.idea/
*.swp
*.swo

# Large Dataset Files
dataset/train/
dataset/test/
dataset/benchmark/
*candidate_pairs*.tsv
*candidate_pairs*.csv

# Output Directory: Keep ONLY matching_results.tsv and .gitkeep
output/*
!output/matching_results.tsv
!output/.gitkeep

# Large Archives & Models
*.zip
*.tar.gz
*.pkl
*.pt
*.bin
*.onnx

# Scratch logs & temporary files
*.log
*.tmp
